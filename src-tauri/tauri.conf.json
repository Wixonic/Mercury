{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Mercury",
	"version": "0.1.1",
	"identifier": "fr.wixonic.mercury",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Mercury",
				"width": 900,
				"height": 600,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"theme": "Dark"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico",
			"icons/icon.png"
		]
	}
}